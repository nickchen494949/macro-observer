{
  "meta": {
    "registryVersion": "1.0",
    "createdBeforeOutcomeEvaluation": true,
    "frozen": true
  },
  "baselines": {
    "momentum": {
      "inputs": ["SPX"],
      "lookbacks": [252],
      "transformations": ["SPX 12M trailing return scaled by 252-session trend strength"],
      "normalization": "expanding_window",
      "winsorization": "1_99",
      "missingPolicy": "exclude"
    },
    "volatility": {
      "inputs": ["SPX"],
      "lookbacks": [20],
      "transformations": ["20D realized volatility"],
      "normalization": "expanding_window",
      "winsorization": "1_99",
      "missingPolicy": "exclude"
    }
  },
  "combinedBaseline": {
    "modelSpecification": "standardized momentum - standardized volatility",
    "trainingOnlyFit": true
  },
  "oosMetrics": {
    "deltaR2": {
      "formula": "1 - (sum((y - y_hat_enhanced)^2) / sum((y - y_hat_baseline)^2))",
      "interpretation": "> 0 = enhanced better than baseline, = 0 = no improvement, < 0 = enhanced worse"
    },
    "deltaMAE": {
      "formula": "MAE_baseline - MAE_enhanced",
      "interpretation": "> 0 = improvement"
    }
  },
  "oosSignificanceTest": {
    "lossDifferential": "d_t = L_baseline,t - L_enhanced,t",
    "primaryTest": "HAC-adjusted loss differential test AND moving-block bootstrap CI on d_t",
    "primaryCondition": "Mean OOS loss improvement > 0 AND bootstrap CI / HAC evidence supports improvement",
    "secondaryTest": "Clark-West test for nested models"
  }
}
