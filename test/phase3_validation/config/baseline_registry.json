{
  "meta": {
    "registryVersion": "1.2",
    "createdBeforeOutcomeEvaluation": true,
    "frozen": true
  },
  "baselines": {
    "momentum": {
      "definition": "momentum_t = AdjClose_t / AdjClose_{t-252} - 1",
      "missingPolicy": "exclude",
      "baselineWinsorization": "none"
    },
    "volatility": {
      "definition": "vol20_t = sqrt(252) * sample_std(log(AdjClose_i / AdjClose_{i-1}), last 20 returns, ddof=1)",
      "missingPolicy": "exclude",
      "baselineWinsorization": "none"
    }
  },
  "combinedBaseline": {
    "definition": "baselineScore = z_mom - z_vol (z_mom and z_vol computed via training-window-only mean/std)",
    "baselineModel": "y = alpha + beta * baselineScore",
    "enhancedModel": "y = alpha + beta * baselineScore + gamma * moduleSignalFeature",
    "estimator": {
      "type": "OLS with intercept",
      "interactions": "No interactions",
      "regularization": "No regularization",
      "hyperparameterTuning": "No hyperparameter tuning"
    }
  },
  "evaluationConstraints": {
    "commonSample": "baseline and enhanced must be evaluated on exactly the same train rows and test rows"
  },
  "oosMetrics": {
    "primaryOOSLoss": "squared_error",
    "primaryOOSTest": {
      "metric": "d_t = (y - y_hat_baseline)^2 - (y - y_hat_enhanced)^2",
      "meanLossDifferential": "> 0",
      "HACPValue": "< 0.05",
      "HACTest": "two_sided",
      "bootstrapCI": "95_percentile",
      "bootstrapLowerBound": "> 0"
    },
    "confirmatoryOOSMetric": {
      "deltaMAE": "> 0 (formula: MAE_baseline - MAE_enhanced)"
    }
  }
}
