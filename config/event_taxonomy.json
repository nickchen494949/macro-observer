    "penaltyWeights": {
      "OPPOSITE_YIELD_MOVE": 0.5
    }
  },
  "GEOPOLITICAL_SHOCK": {
    "description": "Unexpected geopolitical event.",
    "requiredSignals": ["NEWS_HEADLINE_BURST"],
    "supportingSignals": ["OIL_PRICE_SPIKE", "GOLD_PRICE_SPIKE", "VIX_SPIKE", "SAFE_HAVEN_FLOWS"],
    "optionalSignals": ["DEFENSE_EQUITY_MOVE"],
    "contradictingSignals": ["RISK_ON_FLOWS", "VIX_DROP"],
    "penaltyWeights": {
      "RISK_ON_FLOWS": 0.8,
      "VIX_DROP": 0.9
    }
