{
  "rates": {
    "indicators": ["DGS2", "DGS5", "DGS10", "DGS30", "DFII10", "T10Y3M"],
    "changeMethod": "difference_bp",
    "absoluteThreshold": 5,
    "zThreshold": 1.25,
    "rollingWindow": 20
  },
  "equities": {
    "indicators": ["^GSPC", "^IXIC", "^DJI", "^RUT"],
    "changeMethod": "percent_return",
    "absoluteThreshold": 0.75,
    "zThreshold": 1.25,
    "rollingWindow": 20
  },
  "equities_cyclical": {
    "indicators": ["^RUT", "XLF", "XLY", "XLB"],
    "changeMethod": "percent_return",
    "absoluteThreshold": 1.0,
    "zThreshold": 1.25,
    "rollingWindow": 20
  },
  "equities_tech": {
    "indicators": ["^IXIC", "XLK", "SOXX", "IGV", "MAGS"],
    "changeMethod": "percent_return",
    "absoluteThreshold": 1.0,
    "zThreshold": 1.25,
    "rollingWindow": 20
  },
  "gold": {
    "indicators": ["GC=F", "GDX"],
    "changeMethod": "percent_return",
    "absoluteThreshold": 1.0,
    "zThreshold": 1.25,
    "rollingWindow": 20
  },
  "vix": {
    "indicators": ["^VIX"],
    "changeMethod": "percent_return",
    "absoluteThreshold": 10,
    "zThreshold": 1.25,
    "rollingWindow": 20,
